{
  "name": "mcp-management-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.5.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './apps/*' build",
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean",
    "deploy": "pnpm -r --filter './apps/*' deploy",
    "workspace:check": "pnpm -r exec -- npm outdated",
    "workspace:update": "pnpm -r update",
    "bayesian:test": "jest --config test/jest.config.js",
    "bayesian:start": "node bayesian-installer.js",
    "bayesian:integrate": "node -e \"import('./BAYESIAN_EXECUTION_GUIDE.md').then(() => console.log('📖 See BAYESIAN_EXECUTION_GUIDE.md for complete instructions'))\"",
    "bayesian:validate": "node -e \"console.log('🧪 Running Bayesian system validation...'); import('./test/bayesian-installer.test.js')\"",
    "test:unit": "vitest run --config test/vitest.config.js",
    "test:watch": "vitest --config test/vitest.config.js",
    "test:ui": "vitest --ui --config test/vitest.config.js",
    "test:coverage": "vitest run --coverage --config test/vitest.config.js",
    "test:day24": "vitest run test/failure-pattern-learner.test.js test/auto-recovery-system.test.js --config test/vitest.config.js",
    "test:integration": "vitest run test/integration --config test/vitest.config.js",
    "test:integration:watch": "vitest test/integration --config test/vitest.config.js",
    "test:production": "vitest run test/production --config test/vitest.config.js",
    "test:mcp": "node test-full-protocol.cjs",
    "test:mcp:legacy": "node test-all-15-services.cjs",
    "test:hooks": "node test-all-hooks-7projects.cjs",
    "test:hooks:single": "node test-all-hooks-7projects.cjs --project",
    "start:production": "node production-server.js",
    "docker:build": "docker build -t mcp-management .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@types/node": "^22.0.0",
    "@vitest/ui": "^3.2.4",
    "typescript": "^5.3.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@babel/preset-env": "^7.23.0",
    "@jest/globals": "^29.7.0",
    "autocannon": "^8.0.0",
    "axios": "^1.12.2",
    "babel-jest": "^29.7.0",
    "chance": "^1.1.13",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "glob": "^11.0.3",
    "jest": "^29.7.0",
    "jstat": "^1.9.6",
    "node-cache": "^5.1.2",
    "pathe": "^2.0.3",
    "proper-lockfile": "^4.1.2",
    "simple-statistics": "^7.8.8",
    "winston": "^3.17.0"
  }
}
